# /etc/dwh/dwh.env on the DWH server (I16). Owner root:dwh, mode 0640.
# Copy this file, fill in the values on the server; never put it into git or a release package.
DWH_DB_HOST=127.0.0.1
DWH_DB_PORT=5432
DWH_DB_NAME=dwh
DWH_APP_PASSWORD=<password of dwh_app>
DWH_ETL_PASSWORD=<password of dwh_etl>
# Encrypted source credentials (SecretStore files), outside the release folders.
DWH_SECRET_STORE_DIR=/var/lib/dwh/secrets
# Master keys: written by tools/secret_key_tool.py activate --provider systemd-creds
# into /etc/dwh/keyring.env (DWH_SECRET_KEY_PROVIDER, DWH_SECRET_ACTIVE_KEY_ID) - not here.
# CRM connection without the password (the password comes from SecretStore, I04-05).
CRM_DB_HOST=10.30.58.64
CRM_DB_PORT=5432
CRM_DB_NAME=vtb
CRM_DB_USER=vtb
CRM_DB_SSLMODE=prefer
