# I16: DWH API (FastAPI) on 127.0.0.1:8000; nginx is the only way in (HTTPS).
# Master keys: drop-in dwh-.service.d/10-keyring.conf (secret_key_tool.py activate).
[Unit]
Description=DWH API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=dwh
Group=dwh
WorkingDirectory=/opt/dwh/current/src
EnvironmentFile=/etc/dwh/dwh.env
Environment=DWH_ENV_FILE=/etc/dwh/dwh.env
Environment=PYTHONPATH=/opt/dwh/current/src/backend/src:/opt/dwh/current/src/etl/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/dwh/current/venv/bin/python -m uvicorn dwh_api.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-server-header
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/dwh /var/log/dwh

[Install]
WantedBy=multi-user.target
