    reportKey: ReportKey,
    title: string,
    items: RetailReportingOverview['by_status'],
  ) {
    const showCode =
      items.some(
        item => item.code !== null,
      )

    const isOpen =
      openReportingSections.includes(
        reportKey,
      )

    const isHighlighted =
      highlightedReport === reportKey

    const exportMenuOpen =
      exportMenuReport === reportKey

    const isExporting =
      exportingReport === reportKey

    return (
      <section
        id={`report-${reportKey}`}
        className={
          [
            'reporting-panel',

            isHighlighted
              ? 'reporting-search-hit'
              : '',

            exportMenuOpen
              ? 'reporting-export-open'
              : '',
          ]
            .filter(Boolean)
            .join(' ')
        }
      >
        <div className="reporting-panel-header-row">

          <button
            type="button"
            className="reporting-panel-toggle"
            aria-expanded={isOpen}
            onClick={
              () =>
                toggleReportingSection(
                  reportKey,
                )
            }
          >
            <div className="reporting-panel-title">
              <h2>
                {title}
              </h2>
            </div>
          </button>


          <div className="reporting-panel-actions">

            <span className="reporting-record-count">
              {items.length} records
            </span>


            <div className="reporting-export-wrap">

              <button
                type="button"
                className="reporting-export-button"
                disabled={isExporting}
                aria-expanded={exportMenuOpen}
                aria-haspopup="menu"
                onClick={
                  () => {
                    setExportMenuReport(
                      current =>
                        current === reportKey
                          ? null
                          : reportKey,
                    )
                  }
                }
              >
                <span
                  className="reporting-export-icon"
                  aria-hidden="true"
                >
                  
                </span>

                {
                  isExporting
                    ? 'Выгрузка...'
                    : 'Выгрузить'
                }

                <span
                  className="reporting-export-caret"
                  aria-hidden="true"
                >
                  ▾
                </span>
              </button>


              {
                exportMenuOpen
                  ? (
                    <div
                      className="reporting-export-menu"
                      role="menu"
                    >
                      <button
                        type="button"
                        role="menuitem"
                        onClick={
                          () => {
                            void exportReportingSection(
                              reportKey,
                              'xlsx',
                            )
                          }
                        }
                      >
                        <strong>
                          Excel
                        </strong>

                        <span>
                          .xlsx
                        </span>
                      </button>

                      <button
                        type="button"
                        role="menuitem"
                        onClick={
                          () => {
                            void exportReportingSection(
                              reportKey,
                              'pdf',
                            )
                          }
                        }
                      >
                        <strong>
                          PDF
                        </strong>

                        <span>
                          .pdf
                        </span>
                      </button>

                      <button
                        type="button"
                        role="menuitem"
                        onClick={
                          () => {
                            void exportReportingSection(
                              reportKey,
                              'txt',
                            )
                          }
                        }
                      >
                        <strong>
                          Text
                        </strong>

                        <span>
                          .txt
                        </span>
                      </button>
                    </div>
                  )
                  : null
              }

            </div>


            <button
              type="button"
              className="reporting-chevron-button"
              aria-label={
                isOpen
                  ? `Collapse ${title}`
                  : `Expand ${title}`
              }
              aria-expanded={isOpen}
              onClick={
                () =>
                  toggleReportingSection(
                    reportKey,
                  )
              }
            >
              <span
                className={
                  isOpen
                    ? 'reporting-chevron open'
                    : 'reporting-chevron'
                }
                aria-hidden="true"
              >
                {isOpen ? '-' : '+'}
              </span>
            </button>

          </div>
        </div>


        {
          isOpen
            ? (
              <div className="reporting-panel-body">
                <div className="data-table-wrapper">
                  <table className="data-table">
                    <thead>
                      <tr>
                        <th>ID</th>

                        {
                          showCode
                            ? <th>Code</th>
                            : null
                        }

                        <th>Name</th>
                        <th>Applications</th>
                      </tr>
                    </thead>

                    <tbody>
                      {
                        items.map(
                          item => (
                            <tr
                              key={
                                [
                                  title,
                                  item.id ?? '',
                                  item.code ?? '',
                                ].join('-')
                              }
                            >
                              <td className="code-value">
                                {item.id ?? ''}
                              </td>

                              {
                                showCode
                                  ? (
                                    <td className="code-value">
                                      {item.code ?? ''}
                                    </td>
                                  )
                                  : null
                              }

                              <td>
                                {item.name ?? ''}
                              </td>

                              <td>
                                {item.applications}
                              </td>
                            </tr>
                          ),
                        )
                      }
                    </tbody>
                  </table>
                </div>
              </div>
            )
            : null
        }
      </section>
    )
  }

  function renderReportingPage() {
    const sections =
      getReportingSections()

    const searchMatches =
      getReportingSearchMatches()

    return (
      <div className="reporting-page">

        <div className="reporting-sticky-top">

          <header className="workspace-header">
            <div>
              <div className="breadcrumb">
                DWH / Reporting
              </div>

              <h1>
                Retail Applications
              </h1>

              <p>
                Current application snapshot from
                the Retail Data Mart.
              </p>
            </div>

            {
              reportingOverview
                ? (
                  <div className="header-meta">
                    <span className="badge badge-accent">
                      {
                        reportingOverview.applications
                      } APPLICATIONS
                    </span>
                  </div>
                )
                : null
            }
          </header>


          {
            reportingError
              ? (
                <div className="error">
                  <strong>
                    Reporting API error
                  </strong>

                  <span>
                    {reportingError}
                  </span>
                </div>
              )
              : null
          }


          {
            reportingOverview
              ? (
                <>
                  <section className="reporting-kpi-grid">

                    <article className="reporting-kpi-card">
                      <span className="reporting-kpi-label">
                        Applications
                      </span>

                      <strong className="reporting-kpi-value">
                        {
                          reportingOverview.applications
                        }
                      </strong>

                      <small>
                        Current Data Mart snapshot
                      </small>
                    </article>


                    <article className="reporting-kpi-card">
                      <span className="reporting-kpi-label">
                        Bank pre-approved conditions
                      </span>

                      <strong className="reporting-kpi-value">
                        {
                          reportingOverview
                            .requested_amount_rows
                        }
                      </strong>

                      <small>
                        of {
                          reportingOverview.applications
                        } applications
                      </small>
                    </article>


                    <article className="reporting-kpi-card">
                      <span className="reporting-kpi-label">
                        Client-selected conditions
                      </span>

                      <strong className="reporting-kpi-value">
                        {
                          reportingOverview
                            .chosen_amount_rows
                        }
                      </strong>

                      <small>
                        of {
                          reportingOverview.applications
                        } applications
                      </small>
                    </article>


                    <article className="reporting-kpi-card">
                      <span className="reporting-kpi-label">
                        Final issue conditions
                      </span>

                      <strong className="reporting-kpi-value">
                        {
                          reportingOverview
                            .final_amount_rows
                        }
                      </strong>

                      <small>
                        of {
                          reportingOverview.applications
                        } applications
                      </small>
                    </article>

                  </section>


                  <div className="reporting-search-bar">

                    <label className="reporting-search-field">
                      <span>
                        Report filter
                      </span>

                      <input
                        type="text"
                        value={reportingSearch}
                        placeholder="Minimum 3 characters"
                        onChange={
                          event => {
                            setReportingSearch(
                              event.target.value,
                            )

                            setReportingSearchIndex(0)
                            setHighlightedReport(null)
                          }
                        }
                        onKeyDown={
                          event => {
                            if (event.key === 'Enter') {
                              goToNextReportingMatch()
                            }
                          }
                        }
                      />
                    </label>


                    <div className="reporting-search-count">
                      Found:
                      {' '}
                      <strong>
                        {searchMatches.length}
                      </strong>
                    </div>


                    <button
                      type="button"
                      className="reporting-search-next"
                      disabled={
                        searchMatches.length === 0
                      }
                      onClick={
                        goToNextReportingMatch
                      }
                    >
                      Перейти
                    </button>

                  </div>
                </>
              )
              : null
          }

        </div>


        {
          reportingLoading
          && reportingOverview === null
            ? (
              <div className="loading-panel">
                Loading reporting data...
              </div>
            )
            : null
        }


        {
          reportingOverview
            ? (
              <div className="reporting-reports">

                <div className="reporting-grid">
                  {
                    sections.map(
                      section =>
                        renderReportingDimension(
                          section.key,
                          section.title,
                          section.items,
                        ),
                    )
                  }
                </div>

              </div>
            )
            : null
        }

      </div>
    )
  }

  function renderEtlPage() {
    return (
      <>
        <header className="workspace-header">
          <div>
            <div className="breadcrumb">
              DWH / ETL Runs
            </div>

            <h1>
              ETL Runs
            </h1>

            <p>
              Batch history, attempts, FULL / CONTINUE
              execution and job-level results.
            </p>
          </div>

          <div className="header-meta">
            <span className="badge badge-accent">
              {etlRuns.length} RUNS
            </span>
          </div>
        </header>

        {
          error
            ? (
              <div className="error">
                <strong>
                  API error
                </strong>

                <span>
                  {error}
                </span>
              </div>
            )
            : null
        }

        {
          etlLoading && etlRuns.length === 0
            ? (
              <div className="loading-panel">
                Loading ETL history...
              </div>
            )
            : (
              <>
                <section className="etl-layout">
                  <div className="data-table-wrapper">
                    <table className="data-table etl-run-table">
                      <thead>
                        <tr>
                          <th>Batch</th>
                          <th>Mode</th>
                          <th>Attempt</th>
                          <th>Status</th>
                          <th>Root</th>
                          <th>Resume from</th>
                          <th>Success</th>
                          <th>Failed</th>
                          <th>Skipped</th>
                          <th>Contracts</th>
                          <th>Mappings</th>
                          <th>Finished</th>
                        </tr>
                      </thead>

                      <tbody>
                        {
                          etlRuns.map(
                            run => (
                              <tr
                                key={run.batch_run_id}
                                className={
                                  selectedBatchId
                                    === run.batch_run_id
                                    ? 'clickable-row selected-row'
                                    : 'clickable-row'
                                }
                                onClick={
                                  () => {
                                    void selectBatch(
                                      run.batch_run_id,
                                    )
                                  }
                                }
                              >
                                <td className="code-value">
                                  {run.batch_run_id}
                                </td>

                                <td>
                                  <span className="badge badge-accent">
                                    {run.run_mode ?? ''}
                                  </span>
                                </td>

                                <td>
                                  {run.attempt_no ?? ''}
                                </td>

                                <td>
                                  <span
                                    className={
                                      statusClass(
                                        run.status,
                                      )
                                    }
                                  >
                                    {run.status}
                                  </span>
                                </td>

                                <td className="code-value">
                                  {
                                    run.root_batch_run_id
                                    ?? ''
                                  }
                                </td>

                                <td className="code-value">
                                  {
                                    run.resume_from_batch_run_id
                                    ?? ''
                                  }
                                </td>

                                <td>
                                  {run.jobs_success}
                                </td>

                                <td>
                                  {run.jobs_failed}
                                </td>

                                <td>
                                  {run.jobs_skipped}
                                </td>

                                <td>
                                  {run.contract_versions}
                                </td>

                                <td>
                                  {run.mapping_versions}
                                </td>

                                <td>
                                  {
                                    formatDate(
                                      run.finished_at,
                                    )
                                  }
                                </td>
                              </tr>
                            ),
                          )
                        }
                      </tbody>
                    </table>
                  </div>
                </section>

                <div className="section-heading">
                  <div>
                    <span>
                      Selected batch
                    </span>

                    <strong>
                      {
                        selectedBatchId
                        ?? ''
                      }
                    </strong>
                  </div>

                  <small>
                    {
                      etlJobs.length
                    } jobs
                  </small>
                </div>

                <div className="data-table-wrapper">
                  <table className="data-table etl-jobs-table">
                    <thead>
                      <tr>
                        <th>Order</th>
                        <th>Job</th>
                        <th>Status</th>
                        <th>Target</th>
                        <th>Reuse</th>
                        <th>Rows read</th>
                        <th>Inserted</th>
                        <th>Updated</th>
                        <th>Rejected</th>
                        <th>Errors</th>
                        <th>Finished</th>
                      </tr>
                    </thead>

                    <tbody>
                      {
                        etlJobs.map(
                          job => (
                            <tr key={job.job_run_id}>
                              <td>
                                {job.execution_order}
                              </td>

                              <td>
                                <strong>
                                  {job.job_code}
                                </strong>

                                <small className="block-muted">
                                  job_run_id={
                                    job.job_run_id
                                  }
                                </small>
                              </td>

                              <td>
                                <span
                                  className={
                                    statusClass(
                                      job.job_status,
                                    )
                                  }
                                >
                                  {job.job_status}
                                </span>
                              </td>

                              <td className="code-value">
                                {job.target_schema}.{
                                  job.target_object
                                }
                              </td>

                              <td className="code-value">
                                {
                                  job.reused_from_job_run_id
                                  ?? ''
                                }
                              </td>

                              <td>
                                {job.rows_read ?? 0}
                              </td>

                              <td>
                                {job.rows_inserted ?? 0}
                              </td>

                              <td>
                                {job.rows_updated ?? 0}
                              </td>

                              <td>
                                {job.rows_rejected ?? 0}
                              </td>

                              <td>
                                {job.error_count ?? 0}
                              </td>

                              <td>
                                {
                                  formatDate(
                                    job.finished_at,
                                  )
                                }
                              </td>
                            </tr>
                          ),
                        )
                      }
                    </tbody>
                  </table>
                </div>
              </>
            )
        }
      </>
    )
  }

  if (initialLoading) {
    return (
      <div className="startup-screen">
        <div className="startup-logo">
          DWH
        </div>

        <p>
          Loading Integration Control...
        </p>
      </div>
    )
  }


  if (!hasWorkspaceAccess) {
    return (
      <div className="startup-screen">
        <div className="startup-logo">
          DWH
        </div>

        <p>
          No permitted DWH workspace is assigned
          to this account.
        </p>
      </div>
    )
  }


  return (
    <div className="app-shell">
      <aside className="sidebar">
        <div className="brand">
          <div className="brand-mark">
            DWH
          </div>

          <div>
            <strong>
              Data Warehouse
            </strong>

            <small>
              Control Center
            </small>
          </div>
        </div>

        <nav className="main-nav">
          {
            canIntegration
              ? (
                <button
                  type="button"
                  className={
                    activePage === 'integrations'
                      ? 'nav-item active'
                      : 'nav-item'
                  }
                  onClick={
                    () =>
                      setActivePage(
                        'integrations',
                      )
                  }
                >
                  Integration Control
                </button>
              )
              : null
          }

          {
            canEtl
              ? (
                <button
                  type="button"
                  className={
                    activePage === 'etl'
                      ? 'nav-item active'
                      : 'nav-item'
                  }
                  onClick={
                    () =>
                      setActivePage(
                        'etl',
                      )
                  }
                >
                  ETL Runs
                </button>
              )
              : null
          }

          {
            canDq
              ? (
                <button
                  type="button"
                  className={
                    activePage === 'dq'
                      ? 'nav-item active'
                      : 'nav-item'
                  }
                  onClick={
                    () =>
                      setActivePage(
                        'dq',
                      )
                  }
                >
                  Data Quality
                </button>
              )
              : null
          }

          {
            canReporting
              ? (
                <button
                  type="button"
                  className={
                    activePage === 'reporting'
                      ? 'nav-item active'
                      : 'nav-item'
                  }
                  onClick={
                    () => {
                      void selectReportingPage()
                    }
                  }
                >
                  Reporting
                </button>
              )
              : null
          }

          {
            canAdministration
              ? (
                <button
                  type="button"
                  className={
                    activePage === 'administration'
                      ? 'nav-item active'
                      : 'nav-item'
                  }
                  onClick={
                    () =>
                      setActivePage(
                        'administration',
                      )
                  }
                >
                  Administration
                </button>
              )
              : null
          }
        </nav>

        <div
          className={
            activePage === 'integrations'
              ? 'sidebar-integration-area'
              : 'sidebar-integration-area hidden'
          }
        >
        <div className="sidebar-section-title">
          Integrations
          <span>
            {
              integrations.length
            }
          </span>
        </div>

        <div className="integration-list">
          {
            integrations.map(
              integration => (
                <button
                  type="button"
                  key={
                    integration.source_object_id
                  }
                  className={
                    integration.source_object_id
                      === selectedId
                      ? 'integration-item selected'
                      : 'integration-item'
                  }
                  onClick={
                    () =>
                      selectIntegration(
                        integration.source_object_id,
                      )
                  }
                >
                  <span className="integration-name">
                    {
                      integration.source_object
                    }
                  </span>

                  <small>
                    {
                      integration.load_strategy
                    }
                  </small>
                </button>
              ),
            )
          }
        </div>

        </div>

        <div className="sidebar-footer">
          <div className="sidebar-user">
            <div className="sidebar-user-text">
              <strong>
                {
                  auth.user?.display_name
                  ?? auth.user?.username
                  ?? ''
                }
              </strong>

              <small>
                {
                  auth.user?.account_level
                  ?? ''
                }
              </small>
            </div>

            <button
              type="button"
              className="sidebar-signout"
              onClick={
                () => {
                  void logout()
                }
              }
            >
              Sign out
            </button>
          </div>

          <div className="sidebar-health">
            <span
              className={
                statusClass(
                  health?.status,
                )
              }
            >
              {
                health?.status
                ?? 'UNKNOWN'
              }
            </span>

            <small>
              {
                health?.database_user
                ?? ''
              } @ {
                health?.database_name
                ?? ''
              }
            </small>
          </div>
        </div>
      </aside>


      <main
        className={
          activePage === 'reporting'
            ? 'workspace workspace-reporting'
            : 'workspace'
        }
      >
        {
          activePage === 'etl'
            ? renderEtlPage()
            : activePage === 'dq'
              ? renderDqPage()
              : activePage === 'reporting'
                ? renderReportingPage()
                : activePage === 'administration'
                  ? <AdminPage />
                  : (
              <>
        <header className="workspace-header">
          <div>
            <div className="breadcrumb">
              DWH / Integration Control
            </div>

            <h1>
              {
                selectedIntegration?.source_object
                ?? 'Integration Control'
              }
            </h1>

            <p>
              {
                selectedIntegration?.description
                ?? 'Select integration object'
              }
            </p>
          </div>

          {
            selectedIntegration
              ? (
                <div className="header-meta">
                  <span
                    className={
                      selectedIntegration.integration_active
                        ? 'badge badge-success'
                        : 'badge'
                    }
                  >
                    {
                      selectedIntegration.integration_active
                        ? 'ACTIVE'
                        : 'DISABLED'
                    }
                  </span>

                  <span className="header-object-type">
                    {
                      selectedIntegration.object_type
                    }
                  </span>
                </div>
              )
              : null
          }
        </header>


        {
          error
            ? (
              <div className="error">
                <strong>
                  API error
                </strong>

                <span>
                  {error}
                </span>
              </div>
            )
            : null
        }


        <div className="tabs">
          {
            tabs.map(
              tab => (
                <button
                  type="button"
                  key={
                    tab.key
                  }
                  className={
                    activeTab === tab.key
                      ? 'tab active'
                      : 'tab'
                  }
                  onClick={
                    () =>
                      setActiveTab(
                        tab.key,
                      )
                  }
                >
                  {
                    tab.label
                  }
                </button>
              ),
            )
          }
        </div>


        <section className="content-panel">
          {
            detailLoading
              ? (
                <div className="loading-panel">
                  Loading integration data...
                </div>
              )
              : renderActiveTab()
          }
        </section>
              </>
            )
        }
      </main>
    </div>
  )
}

export default App