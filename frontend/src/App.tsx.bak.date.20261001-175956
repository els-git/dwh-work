import {
  useEffect,
  useMemo,
  useState,
} from 'react'

import {
  getDqRunIssues,
  getDqRunResults,
  getDqRuns,
  getEtlRunJobs,
  getEtlRuns,
  getHealth,
  getIntegrationDqRules,
  getIntegrationErrors,
  getIntegrationIssues,
  getIntegrationMappings,
  getIntegrationOverview,
  getIntegrationRuns,
  getIntegrationStructure,
  getIntegrationValidations,
  getIntegrations,
  getRetailReportingOverview,
  downloadRetailReport,
} from './api'

import type {
  DqIssue,
  DqResult,
  DqRun,
  EtlError,
  EtlJobRun,
  EtlRun,
  HealthResponse,
  IntegrationDqRule,
  IntegrationMapping,
  IntegrationObject,
  IntegrationOverview,
  RetailReportingOverview,
  SourceColumn,
  ValidationContract,
} from './types'

import './App.css'
import { useAuth } from './AuthGate'
import AdminPage from './AdminPage'


type PageKey =
  | 'integrations'
  | 'etl'
  | 'dq'
  | 'reporting'
  | 'administration'


type ReportKey =
  | 'status'
  | 'stage'
  | 'channel'
  | 'product'

type TabKey =
  | 'overview'
  | 'structure'
  | 'mapping'
  | 'validations'
  | 'dq'
  | 'runs'
  | 'errors'
  | 'issues'


interface TabDefinition {
  key: TabKey
  label: string
}


const tabs: TabDefinition[] = [
  {
    key: 'overview',
    label: 'Overview',
  },
  {
    key: 'structure',
    label: 'Structure',
  },
  {
    key: 'mapping',
    label: 'Mapping',
  },
  {
    key: 'validations',
    label: 'Validations',
  },
  {
    key: 'dq',
    label: 'DQ Rules',
  },
  {
    key: 'runs',
    label: 'Runs',
  },
  {
    key: 'errors',
    label: 'Errors',
  },
  {
    key: 'issues',
    label: 'Issues',
  },
]


function formatDate(
  value: string | null | undefined,
): string {
  if (!value) {
    return ''
  }

  const date = new Date(value)

  if (Number.isNaN(date.getTime())) {
    return value
  }

  return date.toLocaleString()
}


function yesNo(
  value: boolean,
): string {
  return value ? 'YES' : 'NO'
}


function statusClass(
  status: string | null | undefined,
): string {
  const normalized =
    status?.toUpperCase() ?? ''

  if (
    normalized === 'SUCCESS'
    || normalized === 'ACTIVE'
    || normalized === 'OK'
  ) {
    return 'badge badge-success'
  }

  if (
    normalized === 'FAILED'
    || normalized === 'ERROR'
  ) {
    return 'badge badge-danger'
  }

  if (
    normalized === 'WARNING'
    || normalized === 'RUNNING'
  ) {
    return 'badge badge-warning'
  }

  return 'badge'
}


function App() {
  const {
    auth,
    hasPermission,
    hasResource,
    logout,
  } = useAuth()

  const hasCdpAccess =
    hasResource(
      'MODULE',
      'CDP',
    )

  const canIntegration =
    hasCdpAccess
    && hasPermission(
      'NAV_INTEGRATION_VIEW',
    )
    && hasPermission(
      'INTEGRATION_VIEW',
    )

  const canEtl =
    hasCdpAccess
    && hasPermission(
      'NAV_ETL_VIEW',
    )
    && hasPermission(
      'ETL_VIEW',
    )

  const canDq =
    hasCdpAccess
    && hasPermission(
      'NAV_DQ_VIEW',
    )
    && hasPermission(
      'DQ_VIEW',
    )

  const canReporting =
    hasCdpAccess
    && hasPermission(
      'NAV_REPORTING_VIEW',
    )
    && hasPermission(
      'REPORT_VIEW',
    )

  const isAdministrator =
    auth.user?.account_level
      === 'SUPERADMIN'
    || auth.user?.account_level
      === 'ADMIN'

  const canAdministration =
    isAdministrator
    && (
      hasPermission(
        'ADMIN_MODULE_MANAGE',
      )
      || hasPermission(
        'ADMIN_USER_MANAGE',
      )
      || hasPermission(
        'ADMIN_ROLE_MANAGE',
      )
      || hasPermission(
        'ADMIN_ACCESS_MANAGE',
      )
    )

  const hasWorkspaceAccess =
    canIntegration
    || canEtl
    || canDq
    || canReporting
    || canAdministration
  const [
    activePage,
    setActivePage,
  ] = useState<PageKey>('integrations')

  const [
    reportingOverview,
    setReportingOverview,
  ] = useState<RetailReportingOverview | null>(null)

  const [
    reportingLoading,
    setReportingLoading,
  ] = useState(false)

  const [
    reportingError,
    setReportingError,
  ] = useState<string | null>(null)

  const [
    openReportingSections,
    setOpenReportingSections,
  ] = useState<ReportKey[]>([])

  const [
    reportingSearch,
    setReportingSearch,
  ] = useState('')

  const [
    reportingSearchIndex,
    setReportingSearchIndex,
  ] = useState(0)

  const [
    highlightedReport,
    setHighlightedReport,
  ] = useState<ReportKey | null>(null)

  const [
    exportMenuReport,
    setExportMenuReport,
  ] = useState<ReportKey | null>(null)

  const [
    exportingReport,
    setExportingReport,
  ] = useState<ReportKey | null>(null)

  const [
    health,
    setHealth,
  ] = useState<HealthResponse | null>(null)

  const [
    integrations,
    setIntegrations,
  ] = useState<IntegrationObject[]>([])

  const [
    selectedId,
    setSelectedId,
  ] = useState<number | null>(null)

  const [
    activeTab,
    setActiveTab,
  ] = useState<TabKey>('overview')

  const [
    overview,
    setOverview,
  ] = useState<IntegrationOverview | null>(null)

  const [
    structure,
    setStructure,
  ] = useState<SourceColumn[]>([])

  const [
    mappings,
    setMappings,
  ] = useState<IntegrationMapping[]>([])

  const [
    validations,
    setValidations,
  ] = useState<ValidationContract[]>([])

  const [
    dqRules,
    setDqRules,
  ] = useState<IntegrationDqRule[]>([])

  const [
    runs,
    setRuns,
  ] = useState<EtlJobRun[]>([])

  const [
    errors,
    setErrors,
  ] = useState<EtlError[]>([])

  const [
    issues,
    setIssues,
  ] = useState<DqIssue[]>([])

  const [
    etlRuns,
    setEtlRuns,
  ] = useState<EtlRun[]>([])

  const [
    selectedBatchId,
    setSelectedBatchId,
  ] = useState<number | null>(null)

  const [
    etlJobs,
    setEtlJobs,
  ] = useState<EtlJobRun[]>([])

  const [
    etlLoading,
    setEtlLoading,
  ] = useState(false)

  const [
    globalDqRuns,
    setGlobalDqRuns,
  ] = useState<DqRun[]>([])

  const [
    selectedDqRunId,
    setSelectedDqRunId,
  ] = useState<number | null>(null)

  const [
    globalDqResults,
    setGlobalDqResults,
  ] = useState<DqResult[]>([])

  const [
    globalDqIssues,
    setGlobalDqIssues,
  ] = useState<DqIssue[]>([])

  const [
    dqLoading,
    setDqLoading,
  ] = useState(false)

  const [
    initialLoading,
    setInitialLoading,
  ] = useState(true)

  const [
    detailLoading,
    setDetailLoading,
  ] = useState(false)

  const [
    error,
    setError,
  ] = useState<string | null>(null)


  useEffect(() => {
    let cancelled = false

    async function loadInitialData() {
      try {
        setError(null)

        const healthResult =
          await getHealth()

        if (cancelled) {
          return
        }

        setHealth(
          healthResult,
        )


        if (canIntegration) {
          const integrationsResult =
            await getIntegrations()

          if (cancelled) {
            return
          }

          setIntegrations(
            integrationsResult,
          )

          if (
            integrationsResult.length > 0
          ) {
            setSelectedId(
              integrationsResult[0]
                .source_object_id,
            )
          }

          setActivePage(
            'integrations',
          )

          return
        }


        setIntegrations([])
        setSelectedId(null)


        if (canEtl) {
          setActivePage(
            'etl',
          )

          return
        }


        if (canDq) {
          setActivePage(
            'dq',
          )

          return
        }


        if (canReporting) {
          setActivePage(
            'reporting',
          )

          setReportingLoading(
            true,
          )

          try {
            const reportingResult =
              await getRetailReportingOverview()

            if (!cancelled) {
              setReportingOverview(
                reportingResult,
              )
            }
          } catch (reportError) {
            if (!cancelled) {
              setReportingError(
                reportError instanceof Error
                  ? reportError.message
                  : 'Failed to load reporting data',
              )
            }
          } finally {
            if (!cancelled) {
              setReportingLoading(
                false,
              )
            }
          }
        }
      } catch (loadError) {
        if (cancelled) {
          return
        }

        setError(
          loadError instanceof Error
            ? loadError.message
            : 'Unknown error',
        )
      } finally {
        if (!cancelled) {
          setInitialLoading(
            false,
          )
        }
      }
    }

    void loadInitialData()

    return () => {
      cancelled = true
    }
  }, [
    canDq,
    canEtl,
    canIntegration,
    canReporting,
  ])


  useEffect(() => {
    if (selectedId === null) {
      return
    }

    let cancelled = false

    async function loadIntegrationDetails() {
      try {
        setDetailLoading(true)
        setError(null)

        const [
          overviewResult,
          structureResult,
          mappingsResult,
          validationsResult,
          dqRulesResult,
          runsResult,
          errorsResult,
          issuesResult,
        ] = await Promise.all([
          getIntegrationOverview(selectedId!),
          getIntegrationStructure(selectedId!),
          getIntegrationMappings(selectedId!),
          getIntegrationValidations(selectedId!),
          getIntegrationDqRules(selectedId!),
          getIntegrationRuns(selectedId!),
          getIntegrationErrors(selectedId!),
          getIntegrationIssues(selectedId!),
        ])

        if (cancelled) {
          return
        }

        setOverview(
          overviewResult,
        )

        setStructure(
          structureResult,
        )

        setMappings(
          mappingsResult,
        )

        setValidations(
          validationsResult,
        )

        setDqRules(
          dqRulesResult,
        )

        setRuns(
          runsResult,
        )

        setErrors(
          errorsResult,
        )

        setIssues(
          issuesResult,
        )
      } catch (loadError) {
        if (cancelled) {
          return
        }

        setError(
          loadError instanceof Error
            ? loadError.message
            : 'Unknown error',
        )
      } finally {
        if (!cancelled) {
          setDetailLoading(false)
        }
      }
    }

    void loadIntegrationDetails()

    return () => {
      cancelled = true
    }
  }, [selectedId])


  useEffect(() => {
    if (activePage !== 'etl') {
      return
    }

    let cancelled = false

    async function loadEtlRuns() {
      try {
        setEtlLoading(true)
        setError(null)

        const runsResult =
          await getEtlRuns()

        if (cancelled) {
          return
        }

        setEtlRuns(
          runsResult,
        )

        const firstBatchId =
          selectedBatchId
          ?? runsResult[0]?.batch_run_id
          ?? null

        if (firstBatchId === null) {
          setSelectedBatchId(null)
          setEtlJobs([])
          return
        }

        setSelectedBatchId(
          firstBatchId,
        )

        const jobsResult =
          await getEtlRunJobs(
            firstBatchId,
          )

        if (!cancelled) {
          setEtlJobs(
            jobsResult,
          )
        }
      } catch (loadError) {
        if (!cancelled) {
          setError(
            loadError instanceof Error
              ? loadError.message
              : 'Unknown error',
          )
        }
      } finally {
        if (!cancelled) {
          setEtlLoading(false)
        }
      }
    }

    void loadEtlRuns()

    return () => {
      cancelled = true
    }
  }, [activePage])


  async function selectBatch(
    batchRunId: number,
  ) {
    try {
      setSelectedBatchId(
        batchRunId,
      )

      setEtlLoading(true)
      setError(null)

      const jobsResult =
        await getEtlRunJobs(
          batchRunId,
        )

      setEtlJobs(
        jobsResult,
      )
    } catch (loadError) {
      setError(
        loadError instanceof Error
          ? loadError.message
          : 'Unknown error',
      )
    } finally {
      setEtlLoading(false)
    }
  }

  useEffect(() => {
    if (activePage !== 'dq') {
      return
    }

    let cancelled = false

    async function loadDataQuality() {
      try {
        setDqLoading(true)
        setError(null)

        const runsResult =
          await getDqRuns()

        if (cancelled) {
          return
        }

        setGlobalDqRuns(
          runsResult,
        )

        const firstRunId =
          selectedDqRunId
          ?? runsResult[0]?.dq_run_id
          ?? null

        if (firstRunId === null) {
          setSelectedDqRunId(null)
          setGlobalDqResults([])
          setGlobalDqIssues([])
          return
        }

        setSelectedDqRunId(
          firstRunId,
        )

        const [
          resultsResult,
          issuesResult,
        ] = await Promise.all([
          getDqRunResults(firstRunId),
          getDqRunIssues(firstRunId),
        ])

        if (!cancelled) {
          setGlobalDqResults(
            resultsResult,
          )

          setGlobalDqIssues(
            issuesResult,
          )
        }
      } catch (loadError) {
        if (!cancelled) {
          setError(
            loadError instanceof Error
              ? loadError.message
              : 'Unknown error',
          )
        }
      } finally {
        if (!cancelled) {
          setDqLoading(false)
        }
      }
    }

    void loadDataQuality()

    return () => {
      cancelled = true
    }
  }, [activePage])


  async function selectDqRun(
    dqRunId: number,
  ) {
    try {
      setSelectedDqRunId(
        dqRunId,
      )

      setDqLoading(true)
      setError(null)

      const [
        resultsResult,
        issuesResult,
      ] = await Promise.all([
        getDqRunResults(dqRunId),
        getDqRunIssues(dqRunId),
      ])

      setGlobalDqResults(
        resultsResult,
      )

      setGlobalDqIssues(
        issuesResult,
      )
    } catch (loadError) {
      setError(
        loadError instanceof Error
          ? loadError.message
          : 'Unknown error',
      )
    } finally {
      setDqLoading(false)
    }
  }

  const selectedIntegration = useMemo(
    () => integrations.find(
      item =>
        item.source_object_id
        === selectedId,
    ) ?? null,
    [
      integrations,
      selectedId,
    ],
  )


  function selectIntegration(
    sourceObjectId: number,
  ) {
    setSelectedId(
      sourceObjectId,
    )

    setActiveTab(
      'overview',
    )
  }


  function renderOverview() {
    if (!overview) {
      return null
    }

    return (
      <>
        <div className="metric-grid">
          <article className="metric-card">
            <span>Source columns</span>
            <strong>
              {
                overview.integration.source_columns
              }
            </strong>
            <small>
              PK: {
                overview.integration.pk_columns
              }
            </small>
          </article>

          <article className="metric-card">
            <span>Mappings</span>
            <strong>
              {
                overview.integration.total_mappings
              }
            </strong>
            <small>
              Source coverage: {
                overview.integration.mapped_source_columns
              }
            </small>
          </article>

          <article className="metric-card">
            <span>Contracts</span>
            <strong>
              {
                overview.integration.active_contracts
              }
            </strong>
            <small>
              Required: {
                overview.integration.required_columns
              }
            </small>
          </article>

          <article className="metric-card">
            <span>DQ Rules</span>
            <strong>
              {
                overview.dq_rules_total
              }
            </strong>
            <small>
              {
                overview.dq_error_rules
              } ERROR / {
                overview.dq_warning_rules
              } WARNING
            </small>
          </article>

          <article className="metric-card">
            <span>Open DQ issues</span>
            <strong>
              {
                overview.open_dq_issues
              }
            </strong>
            <small>
              Current unresolved issues
            </small>
          </article>

          <article className="metric-card">
            <span>Technical errors</span>
            <strong>
              {
                overview.technical_errors
              }
            </strong>
            <small>
              Historical ETL error records
            </small>
          </article>
        </div>

        <div className="overview-grid">
          <section className="info-card">
            <h3>Integration</h3>

            <dl>
              <dt>Source</dt>
              <dd>
                {
                  overview.integration.source_schema
                }.{
                  overview.integration.source_object
                }
              </dd>

              <dt>STG</dt>
              <dd>
                {
                  overview.integration.stg_schema
                }.{
                  overview.integration.stg_table
                }
              </dd>

              <dt>ODS</dt>
              <dd>
                {overview.ods_schema}.{
                  overview.ods_object
                }
              </dd>

              <dt>Strategy</dt>
              <dd>
                {
                  overview.integration.load_strategy
                }
              </dd>

              <dt>Watermark</dt>
              <dd>
                {
                  overview.integration.watermark_column
                  ?? ''
                }
              </dd>

              <dt>Metadata captured</dt>
              <dd>
                {
                  formatDate(
                    overview.integration.metadata_captured_at,
                  )
                }
              </dd>
            </dl>
          </section>

          <section className="info-card">
            <h3>Latest ETL job</h3>

            {
              overview.latest_job
                ? (
                  <dl>
                    <dt>Status</dt>
                    <dd>
                      <span
                        className={
                          statusClass(
                            overview.latest_job.job_status,
                          )
                        }
                      >
                        {
                          overview.latest_job.job_status
                        }
                      </span>
                    </dd>

                    <dt>Batch</dt>
                    <dd>
                      {
                        overview.latest_job.batch_run_id
                      }
                    </dd>

                    <dt>Mode</dt>
                    <dd>
                      {
                        overview.latest_job.run_mode
                        ?? ''
                      }
                    </dd>

                    <dt>Attempt</dt>
                    <dd>
                      {
                        overview.latest_job.attempt_no
                        ?? ''
                      }
                    </dd>

                    <dt>Rows read</dt>
                    <dd>
                      {
                        overview.latest_job.rows_read
                        ?? 0
                      }
                    </dd>

                    <dt>Finished</dt>
                    <dd>
                      {
                        formatDate(
                          overview.latest_job.finished_at,
                        )
                      }
                    </dd>
                  </dl>
                )
                : (
                  <p className="empty">
                    No ETL history
                  </p>
                )
            }
          </section>

          <section className="info-card">
            <h3>Latest DQ run</h3>

            {
              overview.latest_dq_run
                ? (
                  <dl>
                    <dt>Status</dt>
                    <dd>
                      <span
                        className={
                          statusClass(
                            overview.latest_dq_run.status,
                          )
                        }
                      >
                        {
                          overview.latest_dq_run.status
                        }
                      </span>
                    </dd>

                    <dt>DQ run</dt>
                    <dd>
                      {
                        overview.latest_dq_run.dq_run_id
                      }
                    </dd>

                    <dt>Rules</dt>
                    <dd>
                      {
                        overview.latest_dq_run.rules_total
                      }
                    </dd>

                    <dt>Passed</dt>
                    <dd>
                      {
                        overview.latest_dq_run.rules_passed
                      }
                    </dd>

                    <dt>Failed</dt>
                    <dd>
                      {
                        overview.latest_dq_run.rules_failed
                      }
                    </dd>

                    <dt>Finished</dt>
                    <dd>
                      {
                        formatDate(
                          overview.latest_dq_run.finished_at,
                        )
                      }
                    </dd>
                  </dl>
                )
                : (
                  <p className="empty">
                    No DQ history
                  </p>
                )
            }
          </section>
        </div>
      </>
    )
  }


  function renderStructure() {
    return (
      <div className="data-table-wrapper">
        <table className="data-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Column</th>
              <th>Source type</th>
              <th>Nullable</th>
              <th>PK</th>
              <th>Unique</th>
              <th>Identity</th>
              <th>Generated</th>
            </tr>
          </thead>

          <tbody>
            {
              structure.map(
                column => (
                  <tr
                    key={
                      `${column.ordinal_position}-${column.source_column}`
                    }
                  >
                    <td>
                      {
                        column.ordinal_position
                      }
                    </td>

                    <td className="code-value">
                      {
                        column.source_column
                      }
                    </td>

                    <td>
                      {
                        column.source_type
                      }
                    </td>

                    <td>
                      {
                        yesNo(
                          column.is_nullable,
                        )
                      }
                    </td>

                    <td>
                      {
                        yesNo(
                          column.is_primary_key,
                        )
                      }
                    </td>

                    <td>
                      {
                        yesNo(
                          column.is_unique_key,
                        )
                      }
                    </td>

                    <td>
                      {
                        yesNo(
                          column.is_identity,
                        )
                      }
                    </td>

                    <td>
                      {
                        yesNo(
                          column.is_generated,
                        )
                      }
                    </td>
                  </tr>
                ),
              )
            }
          </tbody>
        </table>
      </div>
    )
  }


  function renderMappings() {
    return (
      <div className="data-table-wrapper">
        <table className="data-table mapping-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Type</th>
              <th>Source</th>
              <th>Target</th>
              <th>PG type</th>
              <th>Expression</th>
              <th>Version</th>
            </tr>
          </thead>

          <tbody>
            {
              mappings.map(
                mapping => (
                  <tr
                    key={
                      mapping.mapping_id
                    }
                  >
                    <td>
                      {
                        mapping.mapping_position
                      }
                    </td>

                    <td>
                      <span className="badge badge-accent">
                        {
                          mapping.mapping_type
                        }
                      </span>
                    </td>

                    <td>
                      {
                        mapping.sources.length > 0
                          ? mapping.sources.map(
                            source => (
                              <div
                                className="source-ref"
                                key={
                                  `${source.source_layer}-${source.source_position}-${source.source_column}`
                                }
                              >
                                <small>
                                  {
                                    source.source_layer
                                  }
                                </small>

                                <span>
                                  {
                                    source.source_schema
                                  }.{
                                    source.source_object
                                  }.{
                                    source.source_column
                                  }
                                </span>
                              </div>
                            ),
                          )
                          : ''
                      }
