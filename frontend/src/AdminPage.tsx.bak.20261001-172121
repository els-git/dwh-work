import {
  useEffect,
  useState,
} from 'react'

import { useAuth } from './AuthGate'
import AdminModulesPage from './AdminModulesPage'

import './AdminPage.css'


type AdminSection =
  | 'modules'
  | 'users'
  | 'roles'
  | 'access'


interface AdminSectionDefinition {
  key: AdminSection
  label: string
  permission: string
  description: string
}


const adminSections: AdminSectionDefinition[] = [
  {
    key: 'modules',
    label: 'Modules',
    permission: 'ADMIN_MODULE_MANAGE',
    description:
      'Business module catalog and module lifecycle management.',
  },
  {
    key: 'users',
    label: 'Users',
    permission: 'ADMIN_USER_MANAGE',
    description:
      'User accounts, status and authentication administration.',
  },
  {
    key: 'roles',
    label: 'Roles',
    permission: 'ADMIN_ROLE_MANAGE',
    description:
      'Business roles and role membership administration.',
  },
  {
    key: 'access',
    label: 'Access',
    permission: 'ADMIN_ACCESS_MANAGE',
    description:
      'Permission and resource access policy administration.',
  },
]


function AdminPage() {
  const {
    hasPermission,
  } = useAuth()

  const availableSections =
    adminSections.filter(
      section =>
        hasPermission(
          section.permission,
        ),
    )

  const [
    activeSection,
    setActiveSection,
  ] = useState<AdminSection>('modules')


  useEffect(() => {
    const currentAvailable =
      availableSections.some(
        section =>
          section.key === activeSection,
      )

    if (currentAvailable) {
      return
    }

    const firstAvailable =
      availableSections[0]

    if (firstAvailable) {
      setActiveSection(
        firstAvailable.key,
      )
    }
  }, [
    activeSection,
    availableSections,
  ])


  if (availableSections.length === 0) {
    return (
      <div className="admin-no-access">
        Administration access is not available.
      </div>
    )
  }


  const activeDefinition =
    availableSections.find(
      section =>
        section.key === activeSection,
    )
    ?? availableSections[0]


  function renderSection() {
    if (
      activeDefinition.key
      === 'modules'
    ) {
      return (
        <AdminModulesPage />
      )
    }

    return (
      <section className="admin-placeholder">
        <div className="breadcrumb">
          DWH / Administration / {
            activeDefinition.label
          }
        </div>

        <h1>
          {activeDefinition.label}
        </h1>

        <p>
          {
            activeDefinition.description
          }
        </p>

        <div className="admin-placeholder-card">
          <strong>
            Section foundation ready
          </strong>

          <span>
            Backend and CRUD functions will be added
            in the corresponding Administration phase.
          </span>
        </div>
      </section>
    )
  }


  return (
    <div className="admin-shell">
      <div className="admin-shell-title-row">
        <div>
          <div className="breadcrumb">
            DWH / Administration
          </div>

          <div className="admin-shell-title">
            Administration
          </div>
        </div>

        <span className="badge badge-accent">
          {
            availableSections.length
          } SECTIONS
        </span>
      </div>

      <nav className="admin-shell-nav">
        {
          availableSections.map(
            section => (
              <button
                type="button"
                key={section.key}
                className={
                  activeDefinition.key
                  === section.key
                    ? 'admin-shell-tab active'
                    : 'admin-shell-tab'
                }
                onClick={
                  () =>
                    setActiveSection(
                      section.key,
                    )
                }
              >
                {section.label}
              </button>
            ),
          )
        }
      </nav>

      <div className="admin-shell-content">
        {renderSection()}
      </div>
    </div>
  )
}


export default AdminPage