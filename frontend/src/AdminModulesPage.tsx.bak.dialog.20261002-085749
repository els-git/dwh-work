import {
  useEffect,
  useState,
} from 'react'

import type {
  FormEvent,
} from 'react'

import {
  createModule,
  getModules,
  setModuleActive,
  updateModule,
} from './moduleCatalogApi'

import type {
  ModuleCatalogItem,
} from './moduleCatalogApi'

import { formatDateTime } from './dateTime'

import './AdminModulesPage.css'


type EditorMode =
  | 'create'
  | 'edit'
  | null


function errorMessage(
  error: unknown,
): string {
  if (error instanceof Error) {
    return error.message
  }

  return 'Unknown error'
}


function formatModuleDate(
  value: string,
): string {
  const date =
    new Date(
      value,
    )

  if (
    Number.isNaN(
      date.getTime(),
    )
  ) {
    return value
  }

  return formatDateTime(value)
}


function AdminModulesPage() {
  const [
    modules,
    setModules,
  ] = useState<ModuleCatalogItem[]>([])

  const [
    loading,
    setLoading,
  ] = useState(true)

  const [
    error,
    setError,
  ] = useState<string | null>(null)

  const [
    editorMode,
    setEditorMode,
  ] = useState<EditorMode>(null)

  const [
    moduleCode,
    setModuleCode,
  ] = useState('')

  const [
    moduleName,
    setModuleName,
  ] = useState('')

  const [
    description,
    setDescription,
  ] = useState('')

  const [
    saving,
    setSaving,
  ] = useState(false)

  const [
    changingCode,
    setChangingCode,
  ] = useState<string | null>(null)


  async function loadModules() {
    try {
      setLoading(true)
      setError(null)

      const result =
        await getModules()

      setModules(
        result,
      )
    } catch (loadError) {
      setError(
        errorMessage(
          loadError,
        ),
      )
    } finally {
      setLoading(false)
    }
  }


  useEffect(() => {
    void loadModules()
  }, [])


  function openCreate() {
    setModuleCode('')
    setModuleName('')
    setDescription('')
    setEditorMode('create')
    setError(null)
  }


  function openEdit(
    module: ModuleCatalogItem,
  ) {
    setModuleCode(
      module.module_code,
    )

    setModuleName(
      module.module_name,
    )

    setDescription(
      module.description ?? '',
    )

    setEditorMode('edit')
    setError(null)
  }


  function closeEditor() {
    if (saving) {
      return
    }

    setEditorMode(null)
  }


  async function submitModule(
    event: FormEvent<HTMLFormElement>,
  ) {
    event.preventDefault()

    try {
      setSaving(true)
      setError(null)

      if (editorMode === 'create') {
        await createModule({
          module_code:
            moduleCode.trim(),
          module_name:
            moduleName.trim(),
          description:
            description.trim()
            || null,
        })
      } else if (editorMode === 'edit') {
        await updateModule(
          moduleCode,
          {
            module_name:
              moduleName.trim(),
            description:
              description.trim()
              || null,
          },
        )
      } else {
        return
      }

      setEditorMode(null)

      await loadModules()
    } catch (saveError) {
      setError(
        errorMessage(
          saveError,
        ),
      )
    } finally {
      setSaving(false)
    }
  }


  async function changeActiveState(
    module: ModuleCatalogItem,
  ) {
    const nextState =
      !module.is_active

    const action =
      nextState
        ? 'enable'
        : 'disable'

    const confirmed =
      window.confirm(
        `${action.toUpperCase()} module `
        + `${module.module_code}?`,
      )

    if (!confirmed) {
      return
    }

    try {
      setChangingCode(
        module.module_code,
      )

      setError(null)

      await setModuleActive(
        module.module_code,
        nextState,
      )

      await loadModules()
    } catch (stateError) {
      setError(
        errorMessage(
          stateError,
        ),
      )
    } finally {
      setChangingCode(null)
    }
  }


  return (
    <div className="admin-modules-page">
      <header className="workspace-header">
        <div>
          <div className="breadcrumb">
            DWH / Administration / Modules
          </div>

          <h1>
            Modules
          </h1>

          <p>
            Business module catalog.
            Module code is immutable after creation.
          </p>
        </div>

        <div className="admin-modules-header-actions">
          <span className="badge badge-accent">
            {modules.length} MODULES
          </span>

          <button
            type="button"
            className="admin-primary-button"
            onClick={openCreate}
          >
            Create module
          </button>
        </div>
      </header>

      {
        error
          ? (
            <div className="error">
              <strong>
                Module Catalog error
              </strong>

              <span>
                {error}
              </span>
            </div>
          )
          : null
      }

      {
        editorMode
          ? (
            <section className="admin-module-editor">
              <div className="admin-module-editor-title">
                {
                  editorMode === 'create'
                    ? 'Create module'
                    : `Edit ${moduleCode}`
                }
              </div>

              <form
                className="admin-module-form"
                onSubmit={submitModule}
              >
                <label>
                  <span>
                    Module code
                  </span>

                  <input
                    value={moduleCode}
                    maxLength={64}
                    required
                    readOnly={
                      editorMode === 'edit'
                    }
                    onChange={
                      event =>
                        setModuleCode(
                          event.target.value
                            .toUpperCase(),
                        )
                    }
                    placeholder="EXAMPLE_MODULE"
                  />
                </label>

                <label>
                  <span>
                    Module name
                  </span>

                  <input
                    value={moduleName}
                    maxLength={200}
                    required
                    onChange={
                      event =>
                        setModuleName(
                          event.target.value,
                        )
                    }
                    placeholder="Business module name"
                  />
                </label>

                <label className="admin-module-description">
                  <span>
                    Description
                  </span>

                  <textarea
                    value={description}
                    maxLength={2000}
                    rows={3}
                    onChange={
                      event =>
                        setDescription(
                          event.target.value,
                        )
                    }
                  />
                </label>

                <div className="admin-module-form-actions">
                  <button
                    type="button"
                    className="admin-secondary-button"
                    disabled={saving}
                    onClick={closeEditor}
                  >
                    Cancel
                  </button>

                  <button
                    type="submit"
                    className="admin-primary-button"
                    disabled={saving}
                  >
                    {
                      saving
                        ? 'Saving...'
                        : 'Save'
                    }
                  </button>
                </div>
              </form>
            </section>
          )
          : null
      }

      {
        loading && modules.length === 0
          ? (
            <div className="loading-panel">
              Loading module catalog...
            </div>
          )
          : (
            <div className="data-table-wrapper">
              <table className="data-table admin-modules-table">
                <thead>
                  <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>System</th>
                    <th>Updated</th>
                    <th>Actions</th>
                  </tr>
                </thead>

                <tbody>
                  {
                    modules.map(
                      module => (
                        <tr key={module.resource_id}>
                          <td>
                            <strong className="code-value">
                              {module.module_code}
                            </strong>
                          </td>

                          <td>
                            <strong>
                              {module.module_name}
                            </strong>
                          </td>

                          <td className="admin-module-description-cell">
                            {module.description ?? ''}
                          </td>

                          <td>
                            <span
                              className={
                                module.is_active
                                  ? 'badge badge-success'
                                  : 'badge'
                              }
                            >
                              {
                                module.is_active
                                  ? 'ACTIVE'
                                  : 'DISABLED'
                              }
                            </span>
                          </td>

                          <td>
                            {
                              module.is_system
                                ? 'YES'
                                : 'NO'
                            }
                          </td>

                          <td>
                            {
                              formatModuleDate(
                                module.updated_at,
                              )
                            }
                          </td>

                          <td>
                            <div className="admin-module-row-actions">
                              <button
                                type="button"
                                className="admin-link-button"
                                onClick={
                                  () =>
                                    openEdit(
                                      module,
                                    )
                                }
                              >
                                Edit
                              </button>

                              <button
                                type="button"
                                className="admin-link-button"
                                disabled={
                                  changingCode
                                  === module.module_code
                                }
                                onClick={
                                  () => {
                                    void changeActiveState(
                                      module,
                                    )
                                  }
                                }
                              >
                                {
                                  changingCode
                                  === module.module_code
                                    ? 'Working...'
                                    : module.is_active
                                      ? 'Disable'
                                      : 'Enable'
                                }
                              </button>
                            </div>
                          </td>
                        </tr>
                      ),
                    )
                  }
                </tbody>
              </table>
            </div>
          )
      }
    </div>
  )
}


export default AdminModulesPage